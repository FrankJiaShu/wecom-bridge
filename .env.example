# 企业微信智能机器人长连接凭证
# 获取位置：企业微信管理后台 → 智能机器人 → API 模式 → 长连接
# 注意：这里的 Secret 是「长连接专用密钥」，与 URL 回调模式的 Token/EncodingAESKey 不是一回事
# 注意：本文件含密钥，不要提交到任何仓库
WECOM_BOT_ID=
WECOM_SECRET=

# WebSocket 地址（默认官方地址，一般不用改）
# WECOM_WEBSOCKET_URL=wss://openws.work.weixin.qq.com

# 本地 HTTP API 端口（仅监听 127.0.0.1）
BRIDGE_PORT=8765

# 大脑：omp（BRIDGE_BRAIN=omp 启用；未启用时回退回声模式）
# BRIDGE_BRAIN=omp

# 传给 omp 子进程的额外参数（子进程固定带 --mode rpc --no-ui --no-context-files --session-dir <每聊天独立目录>）
# 默认无；如需自动批准工具调用：OMP_ARGS=--approval-mode yolo（注意：微信里的人可驱动你电脑）
# 想收紧：OMP_ARGS=--tools read,grep,glob,web_search --approval-mode write
# OMP_ARGS=

# 首次联调通道用的回声开关（brain 启用时不生效）
# BRIDGE_ECHO=1

# 进入单聊会话时的欢迎语（留空则不自动回复）
WECOM_WELCOME_TEXT=

# =1 开启回声测试模式：收到文本原样流式回复，用于首次联调验证链路
# BRIDGE_ECHO=1

# 收件箱文件路径（默认 data/inbox.jsonl）
# INBOX_FILE=
